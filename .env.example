# ---------------------------------------------------------------------------
# Route to Own — Competition Front Office
# คัดลอกเป็น .env.local สำหรับงานในเครื่อง และตั้งค่าเดียวกันนี้บน production
# ---------------------------------------------------------------------------

# ฐานข้อมูล — จำเป็นบน production
#
# ลำดับความสำคัญ: DATABASE_URL → POSTGRES_URL → PGlite (เครื่องนักพัฒนาเท่านั้น)
# ถ้าตั้งทั้งสองตัว DATABASE_URL ชนะเสมอ
# การ deploy แบบ serverless ที่ไม่มีค่าใดเลยจะโยนข้อผิดพลาดทันที ไม่ตกไปใช้ PGlite
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ชื่อที่ผู้ให้บริการบางรายตั้งให้ — ตั้งเฉพาะเมื่อจำเป็นต้องเข้ากันได้กับชื่อนั้น
# POSTGRES_URL=""

# วันสิ้นสุดการแข่งขัน — ตั้งเมื่อจะรัน retention เท่านั้น
#
# Set only from an officially confirmed competition cutoff.
# Do not infer or invent this value.
#
# นโยบายลบข้อมูลส่วนบุคคลคือ COMPETITION_CUTOFF_AT + 30 วัน
# ตัวแอปทำงานได้ตามปกติแม้ยังไม่ตั้งค่านี้ — การลงทะเบียน ประเมิน เปรียบเทียบสถาบันการเงิน
# ขอคำปรึกษา และ Secure Verification ไม่ขึ้นกับตัวแปรนี้เลย
# แต่ dry-run และ execute retention จะถูก block แบบ fail closed จนกว่าจะได้วันจริง
# COMPETITION_CUTOFF_AT="YYYY-MM-DDTHH:mm:ss.sssZ"

# ที่เก็บข้อมูลของ PGlite ในเครื่อง — ไม่ตั้ง = เก็บในหน่วยความจำ เหมาะกับการทดสอบ
# PGLITE_DATA_DIR=".pglite"

# เปิดให้ deploy แบบ serverless ใช้ PGlite ได้
#
# ห้ามเปิดค่านี้บน URL สาธารณะที่กรรมการใช้เด็ดขาด
# กรรมการหลายคนอาจถูกส่งไปคนละ instance และสถานะของ PGlite ไม่คงอยู่ข้าม request
# หรือข้าม instance ผู้ที่สร้างใบสมัครไว้จะเปิดผลของตัวเองไม่เจอ
# การ deploy สำหรับกรรมการต้องมี DATABASE_URL หรือ POSTGRES_URL เสมอ
# ALLOW_EPHEMERAL_DB="false"

# Playwright — ชี้ไปยัง URL ที่ deploy แล้ว เพื่อรันชุดเทสต์กับ preview
# E2E_BASE_URL="https://<preview>.vercel.app"
