# ---------------------------------------------------------------------------
# Route to Own — Competition Front Office
# คัดลอกเป็น .env.local สำหรับงานในเครื่อง และตั้งค่าเดียวกันนี้บน production
# ---------------------------------------------------------------------------

# ฐานข้อมูล — จำเป็นบน production
#
# ลำดับความสำคัญ: DATABASE_URL → POSTGRES_URL → PGlite (เครื่องนักพัฒนาเท่านั้น)
# ถ้าตั้งทั้งสองตัว DATABASE_URL ชนะเสมอ
# การ deploy แบบ serverless ที่ไม่มีค่าใดเลยจะโยนข้อผิดพลาดทันที ไม่ตกไปใช้ PGlite
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ชื่อที่ผู้ให้บริการบางรายตั้งให้ — ตั้งเฉพาะเมื่อจำเป็นต้องเข้ากันได้กับชื่อนั้น
# POSTGRES_URL=""

# วันสิ้นสุดการแข่งขัน — จำเป็นบน production
#
# นโยบายลบข้อมูลส่วนบุคคลคือ COMPETITION_CUTOFF_AT + 30 วัน
# ต้องเป็นวันจริงที่ผู้จัดการแข่งขันกำหนด ไม่ใช่ค่าประมาณ
# ถ้าไม่ได้ตั้งบน production ระบบจะหยุดพร้อมข้อความบอกเหตุ ไม่ใช่ลบข้อมูลผิดวัน
# ในเครื่องนักพัฒนาจะใช้ค่าสำรองที่ประกาศไว้ว่าเป็นค่าทดสอบ
COMPETITION_CUTOFF_AT="2026-10-31T23:59:59.000Z"

# ที่เก็บข้อมูลของ PGlite ในเครื่อง — ไม่ตั้ง = เก็บในหน่วยความจำ เหมาะกับการทดสอบ
# PGLITE_DATA_DIR=".pglite"

# เปิดให้ deploy แบบ serverless ใช้ PGlite ได้ — ใช้เพื่อการสาธิตชั่วคราวเท่านั้น
# ข้อมูลจะหายเมื่อ instance ถูกรีไซเคิล ห้ามใช้กับข้อมูลจริง
# ALLOW_EPHEMERAL_DB="false"

# Playwright — ชี้ไปยัง URL ที่ deploy แล้ว เพื่อรันชุดเทสต์กับ preview
# E2E_BASE_URL="https://<preview>.vercel.app"
